{
  "name": "fanxiulu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "data:extract": "node scripts/extract-legacy-static-data.mjs",
    "data:verify": "node scripts/extract-legacy-static-data.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:locale": "vitest run tests/unit/localization.zh-cn.test.ts tests/unit/legacy-runtime-source.test.ts",
    "test:e2e": "playwright test",
    "cloudbase:build": "node scripts/build-cloudbase.mjs",
    "cloudbase:config": "node scripts/prepare-cloudbase-config.mjs",
    "preview": "vite preview",
    "verify": "npm run data:verify && npm run typecheck && npm run test && npm run build && npm run cloudbase:build && node scripts/verify-baseline.mjs",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.8",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.8",
    "vue-tsc": "^2.2.0"
  }
}
